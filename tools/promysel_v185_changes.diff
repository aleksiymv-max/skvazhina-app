+/// An actual amplitude trace captured from the microphone while recording.
+/// Older messages without amplitude metadata show a neutral baseline.
+class _ChatWavePainter extends CustomPainter{
+ final List<double> amplitudes;final double progress;final Color color;
+ const _ChatWavePainter(this.amplitudes,this.progress,this.color);
+ @override void paint(Canvas canvas,Size size){
+   if(size.width<=0||size.height<=0)return;
+   final count=(size.width/4.4).floor().clamp(1,90);
+   final step=size.width/count;
+   final active=(progress.clamp(0,1)*count).round();
+   for(var i=0;i<count;i++){
+     final value=amplitudes.isEmpty?0.10:amplitudes[(i*amplitudes.length/count).floor().clamp(0,amplitudes.length-1)];
+     final h=(4+value.clamp(0,1)*(size.height-5)).toDouble();
+     final x=i*step+step/2-1;
+     final rect=RRect.fromRectAndRadius(Rect.fromLTWH(x,(size.height-h)/2,2,h),const Radius.circular(2));
+     canvas.drawRRect(rect,Paint()..color=i<=active?color:color.withValues(alpha:.30));
+   }
+ }
+ @override bool shouldRepaint(covariant _ChatWavePainter old)=>old.progress!=progress||old.color!=color||old.amplitudes!=amplitudes;
+}
