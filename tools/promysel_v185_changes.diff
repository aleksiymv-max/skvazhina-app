+/// Circular inline video message, not a rectangular attached video link.
+class _ChatRoundVideo extends StatefulWidget{
+ const _ChatRoundVideo({super.key,required this.url});final String url;
+ @override State<_ChatRoundVideo> createState()=>_ChatRoundVideoState();
+}
+class _ChatRoundVideoState extends State<_ChatRoundVideo>{
+ VideoPlayerController? controller;bool _error=false;
+ @override void initState(){super.initState();_init();}
+ Future<void> _init()async{
+   if(widget.url.isEmpty){setState(()=>_error=true);return;}
+   final c=VideoPlayerController.networkUrl(Uri.parse(widget.url));controller=c;
+   try{await c.initialize();await c.setLooping(false);if(mounted)setState((){});}
+   catch(_){if(mounted)setState(()=>_error=true);}
+ }
+ @override void didUpdateWidget(covariant _ChatRoundVideo old){super.didUpdateWidget(old);
+   if(old.url!=widget.url){controller?.dispose();controller=null;_error=false;_init();}
+ }
+ @override void dispose(){controller?.dispose();super.dispose();}
+ @override Widget build(BuildContext context){
+   final c=controller;
+   return GestureDetector(onTap:(){if(c==null||!c.value.isInitialized)return;
+     if(c.value.isPlaying)c.pause();else c.play();setState((){});},
+     child:ClipOval(child:SizedBox(width:205,height:205,child:_error?
+       const Center(child:Icon(Icons.videocam_off_outlined,size:34)):
+       c==null||!c.value.isInitialized?const Center(child:CircularProgressIndicator()):
+       Stack(fit:StackFit.expand,children:[
+         FittedBox(fit:BoxFit.cover,child:SizedBox(width:205,
+           height:205/c.value.aspectRatio,child:VideoPlayer(c))),
+         Center(child:AnimatedBuilder(animation:c,builder:(_,__)=>c.value.isPlaying?
+           const SizedBox.shrink():Icon(Icons.play_circle_fill_rounded,
+             size:48,color:Colors.white.withValues(alpha:.93)))),
+         Positioned(left:12,bottom:10,child:AnimatedBuilder(animation:c,builder:(_,__)=>Text(
+           _durationLabel(c.value.position),style:const TextStyle(color:Colors.white,
+             fontWeight:FontWeight.bold,shadows:[Shadow(blurRadius:5,color:Colors.black)])))),
+       ]))));
+ }
+}
