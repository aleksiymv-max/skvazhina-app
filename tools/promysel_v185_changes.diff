+   final savedDuration=(widget.message['duration_ms'] as num?)?.toInt()??0;
+   final length=_duration>Duration.zero?_duration:Duration(milliseconds:savedDuration);
+   final progress=length.inMilliseconds>0?_position.inMilliseconds/length.inMilliseconds:0.0;
+   final foreground=Theme.of(context).colorScheme.primary;
+   return ConstrainedBox(constraints:const BoxConstraints(maxWidth:285),child:Column(
+     crossAxisAlignment:CrossAxisAlignment.start,children:[
+       Row(mainAxisSize:MainAxisSize.min,children:[
+         IconButton.filled(onPressed:_toggle,tooltip:_playing?'Пауза':'Воспроизвести',
+           icon:Icon(_playing?Icons.pause_rounded:Icons.play_arrow_rounded)),
+         Expanded(child:Column(crossAxisAlignment:CrossAxisAlignment.start,children:[
+           SizedBox(height:31,child:LayoutBuilder(builder:(ctx,size)=>GestureDetector(
+             onTapDown:(d)async{if(length.inMilliseconds>0&&size.maxWidth>0){
+               final fraction=(d.localPosition.dx/size.maxWidth).clamp(0,1);
+               await _player.seek(Duration(milliseconds:(length.inMilliseconds*fraction).round()));
+             }},child:CustomPaint(size:Size(size.maxWidth,31),
+               painter:_ChatWavePainter(amp,progress,foreground))))),
+           Text('${_durationLabel(_position)} / ${_durationLabel(length)}',
+             style:Theme.of(context).textTheme.labelSmall),
+         ])),
+         TextButton(onPressed:_transcribing?null:_transcribe,
+           child:_transcribing?const SizedBox(width:15,height:15,child:CircularProgressIndicator(strokeWidth:2)):
+             const Text('Aa',style:TextStyle(fontSize:17,fontWeight:FontWeight.bold))),
+       ]),
+       if(_transcript!=null&&_transcript!.isNotEmpty)
+         Padding(padding:const EdgeInsets.fromLTRB(6,6,5,2),child:Text(_transcript!,style:const TextStyle(fontSize:14))),
+     ]));
+ }
+}
